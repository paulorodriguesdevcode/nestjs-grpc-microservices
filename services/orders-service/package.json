{
  "name": "orders-service",
  "version": "1.0.0",
  "private": true,
  "description": "Owns orders. Validates the user via users-service and fires a notification via notifications-service — both over gRPC.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "test:cov": "node --require ts-node/register --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.spec.ts\" \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/microservices": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
